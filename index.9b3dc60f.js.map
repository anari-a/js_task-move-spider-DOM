"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
wall.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    var spiderRek = spider.getBoundingClientRect();
    var relX = e.clientX - wallRect.left;
    var relY = e.clientY - wallRect.top;
    var left = relX - spiderRek.width / 2;
    var topy = relY - spiderRek.height / 2;
    left = Math.max(0, Math.min(left, wallRect.width - spiderRek.width));
    topy = Math.max(0, Math.min(topy, wallRect.height - spiderRek.height));
    spider.style.left = left + "px";
    spider.style.top = topy + "px";
});

